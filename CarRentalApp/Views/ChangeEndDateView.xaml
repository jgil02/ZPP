<Window x:Class="CarRentalApp.Views.ChangeEndDateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zmień termin oddania" Height="180" Width="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nowa data zwrotu:" FontWeight="SemiBold"/>
        <DatePicker Grid.Row="1"
                    SelectedDate="{Binding NewEndDate, Mode=TwoWay}"
                    DisplayDateStart="{Binding MinDate, Mode=OneWay}"
                    DisplayDateEnd="{Binding MaxAllowedDate, Mode=OneWay}"
                    SelectedDateFormat="Short"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuluj" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Zapisz" Width="90"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>