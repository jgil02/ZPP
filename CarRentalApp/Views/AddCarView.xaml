<UserControl x:Class="CarRentalApp.Views.AddCarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" Margin="10" Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <TextBlock Text="Dodawanie nowego pojazdu" FontSize="28" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Wypełnij specyfikację modelu oraz dane konkretnego egzemplarza do floty." 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,40"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="INFORMACJE O MODELU" FontSize="12" FontWeight="Bold" 
                                       Foreground="{DynamicResource WorkerAccentBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="Unikalne ID (IdCar)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding IdCar, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,15">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Marka" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Model" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Cena za dobę (zł)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding PricePerDay, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <TextBlock Text="Link do zdjęcia (URL lub /Images/...)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <TextBlock Text="Segment" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding Segment, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <TextBlock Text="Typ nadwozia (np. Sedan, Kombi, SUV)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding BodyType, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>
                        </StackPanel>

                        
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="SPECYFIKACJA TECHNICZNA" FontSize="12" FontWeight="Bold" 
                                       Foreground="{DynamicResource WorkerAccentBrush}" Margin="0,0,0,20"/>

                            <UniformGrid Columns="2" Margin="0,0,0,15">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Paliwo" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding FuelType, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Skrzynia" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding GearboxType, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,15">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Silnik (L)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        
                                        <TextBox Text="{Binding EngineCapacity}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Miejsca" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding SeatsCount, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Drzwi" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding DoorsCount, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Pojemność bagażnika (l)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                    <TextBox Text="{Binding TrunkCapacity, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                             VerticalContentAlignment="Center" Padding="10,0"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="DANE EGZEMPLARZA (FLOTA)" FontSize="12" FontWeight="Bold" 
                                       Foreground="{DynamicResource WorkerAccentBrush}" Margin="0,15,0,15"/>

                            <TextBlock Text="Numer VIN" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                                <TextBox Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,25">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Nr Rejestracyjny" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Przebieg (km)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5">
                                        <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" Height="35" BorderThickness="0" 
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            
                            <Button Content="ZAPISZ SAMOCHÓD WE FLOCIE" 
                                    Command="{Binding SaveCarCommand}"
                                    Height="50" Background="{DynamicResource WorkerAccentBrush}" Foreground="White" 
                                    FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource WorkerAccentHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>