<Window x:Class="CarRentalApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CarRentalApp.ViewModels"
        xmlns:views="clr-namespace:CarRentalApp.Views"
        xmlns:conv="clr-namespace:CarRentalApp.Converters"
        Title="AutoExpert - Panel Zarządzania" 
        Height="800" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:StatusConverter x:Key="StatusConverter"/>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

       
        <DataTemplate DataType="{x:Type vm:AddClientViewModel}">
            <views:AddClientView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AddCarViewModel}">
            <views:AddCarView />
        </DataTemplate>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource FilterSummaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FilterSummaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FilterSummaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FilterSummaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FilterSummaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FilterSummaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250" CornerRadius="4" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8">
                            <Border Background="Transparent" />
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource TextSecondaryBrush}" CornerRadius="4" Margin="0,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuButtonStyleWorker" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#a82e22"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#2C3E50" Offset="0"/>
                                <GradientStop Color="#000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorker}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#922B21" Offset="0"/>
                                        <GradientStop Color="#000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Margin="20">
                <TextBlock Text="AutoExpert" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                <StackPanel Visibility="{Binding IsClient, Converter={StaticResource BoolToVis}}">
                    <Button Content="Samochody" Command="{Binding NavigateCommand}" CommandParameter="Samochody" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Moje Rezerwacje" Command="{Binding NavigateCommand}" CommandParameter="Rezerwacje" Style="{StaticResource MenuButtonStyle}"/>
                    <Separator Background="{DynamicResource PrimaryButtonBrush}" Margin="0,20"/>
                    <Button Content="◐ Zmień Motyw" Command="{Binding ToggleThemeCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Wyloguj" Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsWorker, Converter={StaticResource BoolToVis}}">
                    <Button Content="Katalog Floty" Command="{Binding NavigateCommand}" CommandParameter="Samochody" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Zarządzaj Rezerwacjami" Command="{Binding NavigateCommand}" CommandParameter="ZarzadzajRezerwacjami" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Lista klientów" Command="{Binding NavigateCommand}" CommandParameter="Klienci" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Dodaj Auto" Command="{Binding NavigateCommand}" CommandParameter="DodajAuto" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Dodaj Klienta" Command="{Binding NavigateCommand}" CommandParameter="DodajKlienta" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Separator Background="{DynamicResource PrimaryButtonBrush}" Margin="0,20"/>
                    <Button Content="◐ Zmień Motyw" Command="{Binding ToggleThemeCommand}" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Wyloguj" Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyleWorker}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Lista Samochodów" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Twoja Historia Rezerwacji" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Panel Operacyjny" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Visibility="{Binding IsModuleVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Lista Klientów" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding IsClientsVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                    Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Marka pojazdu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableBrands}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding BrandSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Model" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableModels}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding ModelSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Paliwo" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableFuelTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding FuelSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Nadwozie" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableBodyTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding BodySummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Skrzynia" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableGearboxTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding GearboxSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Status" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding StatusSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Cena (zł / dzień)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding PriceFrom, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource FilterSummaryBgBrush}" Foreground="{DynamicResource FilterSummaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" Width="50" Height="22" VerticalContentAlignment="Center" Padding="2,0"/>
                                <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                <TextBox Text="{Binding PriceTo, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource FilterSummaryBgBrush}" Foreground="{DynamicResource FilterSummaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" Width="50" Height="22" VerticalContentAlignment="Center" Padding="2,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Status" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource CardBackgroundBrush}" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding StatusSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FilterSummaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Button Content="Filtruj" Command="{Binding ApplyFiltersCommand}" Background="{DynamicResource PrimaryButtonBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" Width="70" Height="25" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Content="Wyczyść" Command="{Binding ClearFiltersCommand}" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource SecondaryButtonTextBrush}" Width="60" Height="25" Cursor="Hand"/>
                        </StackPanel>
                    </WrapPanel>
                    
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock Text="Sortuj po" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Width="130" Height="24" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Grid Grid.Row="2">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Cars}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="350" Height="400" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="10,10,20,20">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.50" ShadowDepth="6" Direction="315" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="15,15,15,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Ellipse Width="15" Height="15" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding CurrentStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" 
                                                    Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <TextBlock FontSize="13" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Porównaj"/>
                                                            <Setter Property="Foreground" Value="purple"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedForCompare}" Value="True">
                                                                    <Setter Property="Text" Value="✅ Dodane"/>
                                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <Image Grid.Row="1" Source="{Binding Car.ImagePath}" Margin="20,10,20,10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Grid Grid.Row="2" Margin="20,0,20,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Car.FullName}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Car.PricePerDay}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" zł / dzień" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="3" Margin="20,0,20,20" Foreground="#95A5A6" FontSize="13"><Run Text="{Binding Car.FuelType}"/><Run Text=" • "/><Run Text="{Binding Car.GearboxType}"/><Run Text=" • "/><Run Text="{Binding Car.BodyType}"/></TextBlock>
                                        <Button Grid.Row="4" Content="REZERWUJ" Command="{Binding DataContext.OpenReservationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Vin}" Margin="20,0,20,20" Height="40" Background="{DynamicResource PrimaryButtonBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                        <Button Grid.Row="5" Content="SZCZEGÓŁY POJAZDU" Command="{Binding DataContext.ShowCarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding CarId}" Margin="20,0,20,20" Height="35" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                                       
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-180,180,0" Background="#2C3E50" CornerRadius="15" Padding="15" Width="280" Visibility="{Binding IsComparePanelVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Command="{Binding ToggleCompareListCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding CompareQueue.Count, StringFormat='Porównywarka ({0}/3)'}" Foreground="White" FontWeight="Bold" Margin="10,0" FontSize="18"/>
                                <TextBlock Grid.Column="2" Text="↕" Foreground="#BDC3C7"/>
                            </Grid>
                        </Button>
                        <StackPanel Visibility="{Binding IsCompareListExpanded, Converter={StaticResource BoolToVis}}" Margin="0,15,0,0">
                            <ItemsControl ItemsSource="{Binding CompareQueue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Car.FullName}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="POTWIERDŹ PORÓWNANIE" Command="{Binding OpenCompareCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. HISTORIA -->
                <Border Background="Transparent" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            
                            <RowDefinition Height="*"/>
                            
                        </Grid.RowDefinitions>

                        
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="15,10" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Liczba Twoich rezerwacji: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                <TextBlock Text="{Binding ReservationsHistory.Count}" FontWeight="Bold" Foreground="#2980B9" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReservationsHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,5,15" Padding="25,20">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="270"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    
                                                    <ColumnDefinition Width="Auto"/>
                                                    
                                                </Grid.ColumnDefinitions>

                                                
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CarName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Numer VIN: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Vin}" FontSize="12" Foreground="#2980B9" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="Okres wynajmu: " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Dates}" FontSize="13" Foreground="#34495E" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="KOSZT CAŁKOWITY" FontSize="10" FontWeight="Bold" Foreground="#BDC3C7" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2} zł}" 
                                               FontSize="22" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Right"/>

                                                    <Border Background="#EBF5FB" CornerRadius="4" Padding="10,4" Margin="0,12,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="POTWIERDZONA" FontSize="10" FontWeight="Bold" Foreground="#2980B9"/>
                                                    </Border>

                                                    <Button Content="Zmień termin oddania"
                                                            Width="150"
                                                            Height="30"
                                                            Margin="0,12,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.OpenChangeEndDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowChangeButton, Converter={StaticResource BoolToVis}}"
                                                            Background="{DynamicResource PrimaryButtonBrush}"
                                                            Foreground="{DynamicResource PrimaryButtonTextBrush}"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        
                        <TextBlock Grid.Row="1" Text="Nie masz jeszcze żadnych rezerwacji." 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Foreground="#95A5A6" FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReservationsHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding CurrentView}" Visibility="{Binding IsModuleVisible, Converter={StaticResource BoolToVis}}"/>

                <!-- 4. LISTA KLIENTÓW -->
                <Grid Visibility="{Binding IsClientsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- WYSZUKIWARKA -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15,8" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M15.5 15.5L20 20M11 15C13.2091 15 15 13.2091 15 11C15 8.79086 13.2091 7 11 7C8.79086 7 7 8.79086 7 11C7 13.2091 8.79086 15 11 15Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <Grid Grid.Column="1">
                                <TextBlock Text="Wyszukaj klienta po danych..." IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchClientText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TABELA -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" Padding="5" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="4" Direction="270"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding FilteredClients}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="50" SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="UŻYTKOWNIK" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IMIĘ I NAZWISKO" Width="2*">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TELEFON" Binding="{Binding Phone}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="MIASTO" Binding="{Binding City}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>