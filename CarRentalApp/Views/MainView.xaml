<Window x:Class="CarRentalApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CarRentalApp.ViewModels"
        xmlns:views="clr-namespace:CarRentalApp.Views"
        xmlns:conv="clr-namespace:CarRentalApp.Converters"
        Title="AutoExpert - Panel Zarządzania" 
        Height="800" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#F1F2F6">

    <Window.Resources>
        <conv:StatusConverter x:Key="StatusConverter"/>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- REJESTRACJA NOWYCH MODUŁÓW -->
        <DataTemplate DataType="{x:Type vm:AddClientViewModel}">
            <views:AddClientView />
        </DataTemplate>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuButtonStyleWorker" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#a82e22"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#2C3E50" Offset="0"/>
                                <GradientStop Color="#000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorker}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#922B21" Offset="0"/>
                                        <GradientStop Color="#000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Margin="20">
                <TextBlock Text="AutoExpert" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                <StackPanel Visibility="{Binding IsClient, Converter={StaticResource BoolToVis}}">
                    <Button Content="Samochody" Command="{Binding NavigateCommand}" CommandParameter="Samochody" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Moje Rezerwacje" Command="{Binding NavigateCommand}" CommandParameter="Rezerwacje" Style="{StaticResource MenuButtonStyle}"/>
                    <Separator Background="#34495E" Margin="0,20"/>
                    <Button Content="Wyloguj" Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsWorker, Converter={StaticResource BoolToVis}}">
                    <Button Content="Katalog Floty" Command="{Binding NavigateCommand}" CommandParameter="Samochody" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Zarządzaj Rezerwacjami" Command="{Binding NavigateCommand}" CommandParameter="ZarzadzajRezerwacjami" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Klienci" Command="{Binding NavigateCommand}" CommandParameter="Klienci" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Dodaj Auto" Command="{Binding NavigateCommand}" CommandParameter="DodajAuto" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Button Content="Dodaj Klienta" Command="{Binding NavigateCommand}" CommandParameter="DodajKlienta" Style="{StaticResource MenuButtonStyleWorker}"/>
                    <Separator Background="#34495E" Margin="0,20"/>
                    <Button Content="Wyloguj" Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyleWorker}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- NAGŁÓWKI -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Lista Samochodów" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" 
                           Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Twoja Historia Rezerwacji" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" 
                           Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Panel Operacyjny" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" 
                           Visibility="{Binding IsModuleVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                    Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Marka pojazdu" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableBrands}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding BrandSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Model" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableModels}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding ModelSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Paliwo" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableFuelTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding FuelSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Nadwozie" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableBodyTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding BodySummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Skrzynia" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableGearboxTypes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding GearboxSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Status" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <Grid Width="110">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Background="White" Margin="2,2,22,2" IsHitTestVisible="False" CornerRadius="2">
                                    <TextBlock Text="{Binding StatusSummary}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Cena (zł / dzień)" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding PriceFrom, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="22" VerticalContentAlignment="Center" Padding="2,0"/>
                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="2,0,2,0"/>
                                <TextBox Text="{Binding PriceTo, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="22" VerticalContentAlignment="Center" Padding="2,0"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Przyciski akcji filtrów -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Button Content="Filtruj" Command="{Binding ApplyFiltersCommand}" Background="#34495E" Foreground="White" Width="70" Height="25" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Content="Wyczyść" Command="{Binding ClearFiltersCommand}" Background="#BDC3C7" Foreground="Black" Width="60" Height="25" Cursor="Hand"/>
                        </StackPanel>
                    </WrapPanel>
                    <!-- Sortowanie -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock Text="Sortuj po" Foreground="Gray" FontSize="12" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Width="130" Height="24" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Grid Grid.Row="2">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsCarsVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Cars}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="350" Height="400" Background="White" CornerRadius="12" Margin="10,10,20,20">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.50" ShadowDepth="6" Direction="315" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="15,15,15,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Ellipse Width="15" Height="15" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding CurrentStatus}" Foreground="#7F8C8D" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" 
                                                    Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <TextBlock FontSize="13" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Porównaj"/>
                                                            <Setter Property="Foreground" Value="purple"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedForCompare}" Value="True">
                                                                    <Setter Property="Text" Value="✅ Dodane"/>
                                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <Image Grid.Row="1" Source="{Binding Car.ImagePath}" Margin="20,10,20,10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Grid Grid.Row="2" Margin="20,0,20,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Car.FullName}" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Car.PricePerDay}" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                                                <TextBlock Text=" zł / dzień" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="3" Margin="20,0,20,20" Foreground="#95A5A6" FontSize="13"><Run Text="{Binding Car.FuelType}"/><Run Text=" • "/><Run Text="{Binding Car.GearboxType}"/><Run Text=" • "/><Run Text="{Binding Car.BodyType}"/></TextBlock>
                                        <Button Grid.Row="4" Content="REZERWUJ" Command="{Binding DataContext.OpenReservationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Vin}" Margin="20,0,20,20" Height="40" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                        <Button Grid.Row="5" Content="SZCZEGÓŁY POJAZDU" Command="{Binding DataContext.ShowCarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding CarId}" Margin="20,0,20,20" Height="35" Background="Transparent" Foreground="#34495E" BorderBrush="#BDC3C7" BorderThickness="1" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- PANEL PORÓWNYWARKI -->
                <Border Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-180,180,0" Background="#2C3E50" CornerRadius="15" Padding="15" Width="280" Visibility="{Binding IsComparePanelVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Command="{Binding ToggleCompareListCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding CompareQueue.Count, StringFormat='Porównywarka ({0}/3)'}" Foreground="White" FontWeight="Bold" Margin="10,0" FontSize="18"/>
                                <TextBlock Grid.Column="2" Text="↕" Foreground="#BDC3C7"/>
                            </Grid>
                        </Button>
                        <StackPanel Visibility="{Binding IsCompareListExpanded, Converter={StaticResource BoolToVis}}" Margin="0,15,0,0">
                            <ItemsControl ItemsSource="{Binding CompareQueue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Car.FullName}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="POTWIERDŹ PORÓWNANIE" Command="{Binding OpenCompareCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. HISTORIA -->
                <Border Background="White" CornerRadius="12" Padding="20" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding ReservationsHistory}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" IsReadOnly="True" HeadersVisibility="Column" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SAMOCHÓD" Binding="{Binding CarName}" Width="2*"/>
                            <DataGridTextColumn Header="NUMER VIN" Binding="{Binding Vin}" Width="1.5*"/>
                            <DataGridTextColumn Header="TERMIN" Binding="{Binding Dates}" Width="2*"/>
                            <DataGridTextColumn Header="KOSZT" Binding="{Binding TotalPrice, StringFormat={}{0:N2} zł}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 3. MODUŁY (np. Dodaj Klienta) -->
                <ContentControl Content="{Binding CurrentView}" Visibility="{Binding IsModuleVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>